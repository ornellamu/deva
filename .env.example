# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (MySQL / PostgreSQL / Cloud SQL)
DB_HOST="localhost"
DB_USER="deva_admin"
DB_PASSWORD="your_secure_password"
DB_NAME="deva_hospital_recruitment"
DB_PORT="3306"

# Authentication Secrets
JWT_SECRET="deva_hospital_jwt_super_secret_key_2026"
SESSION_SECRET="deva_hospital_session_secret_2026"

# Email Configuration (Resend, SendGrid, or SMTP)
EMAIL_API_KEY="re_sample_api_key_123456"
EMAIL_FROM="recruitment@devahospital.org"
EMAIL_SERVICE_PROVIDER="resend"

# Cloud Storage Configuration (Cloudinary / Supabase / AWS S3)
FILE_STORAGE_PROVIDER="cloudinary"
FILE_STORAGE_API_KEY="your_storage_api_key"
FILE_STORAGE_SECRET="your_storage_api_secret"
FILE_STORAGE_BUCKET="deva-recruitment-docs"

# Administrator Initial Setup Credentials
ADMIN_INITIAL_EMAIL="admin@devahospital.org"
ADMIN_INITIAL_PASSWORD="Admin@Deva2026!"

